<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Xtask — the release build entry point (ARCHITECTURE.md §9):
        dotnet run [project tools/Xtask] [release]
    Owner card: t_428614c4 (packaging). It is a build-time tool: it is never shipped in any
    release artifact and has no NuGet dependencies.

    It is deliberately a plain console project that drives `dotnet` and `wix` as child processes,
    because the thing being verified is the artifacts those tools produce, not a reimplementation
    of them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xtask</RootNamespace>
    <AssemblyName>xtask</AssemblyName>
    <PublishAot>false</PublishAot>
    <!-- The analyzer set is on repo-wide (Directory.Build.props); this file keeps it honest. -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <!--
      Only for the LibraryImport declarations in OutputDirectoryGuard (OpenProcess /
      QueryFullProcessImageName) - reading the image path of an elevated vht-server.exe from an
      unelevated shell, which is the case the guard exists for. Managed code here is unchanged;
      the source generator emits the unsafe marshalling. Same reason Vht.Interop sets it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The guard and the swap are build-time invariants with real failure modes ("the old set was
         destroyed", "a partially populated artifact folder"), and the only way to test them without
         a running vht-server.exe is to call them directly: tests/Xtask.Tests. -->
    <InternalsVisibleTo Include="Xtask.Tests" />
  </ItemGroup>

</Project>
