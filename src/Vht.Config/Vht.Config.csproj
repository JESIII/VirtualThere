<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 (NOT -windows): this library must stay unit-testable off-Windows and must not
         reference WPF/Win32. The only Windows-specific code is behind OperatingSystem.IsWindows()
         guards in Interop/ (ARCHITECTURE.md 2.2, 9). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Vht.Config</RootNamespace>
    <AssemblyName>Vht.Config</AssemblyName>
    <Version>0.1.0</Version>
    <Description>VirtualThere configuration schema, persistence, device identity and DNS-SD discovery.</Description>
    <!-- Package versions are inline because the repo-wide Directory.Packages.props (central package
         management) is owned by the packaging card. When that lands, move these two entries there. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vht.Config.Tests" />
  </ItemGroup>

</Project>