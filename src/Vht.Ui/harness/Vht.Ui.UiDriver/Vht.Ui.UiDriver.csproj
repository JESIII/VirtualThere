<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Vht.Ui.UiDriver</RootNamespace>
    <AssemblyName>vht-ui-driver</AssemblyName>
    <Product>VirtualThere</Product>
    <Description>Drives the VirtualThere tray UI through UI Automation and captures screenshots (harness only, not shipped).</Description>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- UIAutomationClient/UIAutomationTypes come from the WindowsDesktop framework reference
         that UseWPF pulls in; no explicit assembly references are needed. -->
  </ItemGroup>

</Project>
